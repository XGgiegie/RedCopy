{
  "name": "redcopy",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "scripts": {
    "dev": "cross-env CHOKIDAR_USEPOLLING=true vite",
    "dev:watch": "cross-env CHOKIDAR_USEPOLLING=true vite build --watch",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vue-tsc -b && vite build",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run icons && npm run build && node scripts/package-extension.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@crxjs/vite-plugin": "^2.5.0",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "vfonts": "^0.0.3",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.43",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "canvas": "^3.2.3",
    "cross-env": "^10.1.0",
    "sharp": "^0.35.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
